flowchart TD
    A[User Lands on CineForge AI] --> B{Is User Logged In?};
    B -- No --> C[Show Landing Page<br>Features, Demos, Sign Up/Login];
    B -- Yes --> D[Redirect to Dashboard];
    C --> E[User Authenticates<br>Login/SignUp];
    E --> D;

    subgraph G [Core CineForge AI Workflow]
        D --> F[Create/Select a Project];
        F --> H[Input Raw Idea / Script];
        H --> I[AI Script Structuring<br>NLP Module];
        I --> J[Scene Breakdown & Analysis];
        J --> K{User Action};
        K -- Generate Storyboard --> L[AI Visual Generation<br>Stable Diffusion/DALL·E];
        K -- Get Suggestions --> M[AI Suggests Mood, Lighting, Locations];
        L --> N[Review & Edit Visuals];
        M --> O[Review & Refine Suggestions];
        N --> P[Add to Scene Checklist];
        O --> P;
        P --> Q[Save to Project];
    end

    Q --> R[Access C-Space<br>Share & Collaborate];
    R --> S[Export Project Assets<br>PDF Storyboard, Checklist];
    S --> T[Project Ready for Pre-Production!];