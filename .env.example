# ============================================================================
# CINEFORGE AI - Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-too

# ============================================================================
# SUPABASE DATABASE CONFIGURATION
# ============================================================================
# Get these values from your Supabase project settings:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Go to Settings > Database
# 4. Find "Connection string" section

# Format: postgresql://postgres:[YOUR-PASSWORD]@[HOST]:[PORT]/postgres
# Example: DATABASE_URL=postgresql://postgres:your-password@db.yourproject.supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres:your-password@db.yourproject.supabase.co:5432/postgres

# Alternative: Use connection pooling (recommended for production)
# Go to Settings > Database > Connection Pooling
# DATABASE_URL=postgresql://postgres:your-password@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ============================================================================
# SUPABASE API KEYS (Optional - if using Supabase features directly)
# ============================================================================
# Get these from Settings > API
# SUPABASE_URL=https://yourproject.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key

# ============================================================================
# CORS SETTINGS
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# AI SERVICE API KEYS - Groq and Gemini
# ============================================================================
# Groq API (for fast LLM inference)
GROQ_API_KEY=your-groq-api-key

# Google Gemini API (for Imagen 3 image generation)
GEMINI_API_KEY=your-gemini-api-key

# Default AI Model
model=GPT-4

# ============================================================================
# REDIS CONFIGURATION (for real-time features & task queue)
# ============================================================================
# Local Redis
# REDIS_URL=redis://localhost:6379/0

# Or use Upstash Redis (free tier available)
# Get from: https://upstash.com/
# REDIS_URL=rediss://default:your-password@your-redis.upstash.io:6379

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@cineforge.ai

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================
MAX_FILE_UPLOAD_MB=50

# ============================================================================
# SUPABASE STORAGE (Optional - for file uploads)
# ============================================================================
# If using Supabase Storage instead of local file storage
# SUPABASE_STORAGE_BUCKET=cineforge-uploads
